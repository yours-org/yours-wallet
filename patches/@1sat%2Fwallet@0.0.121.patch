--- a/dist/permissions/manager.js
+++ b/dist/permissions/manager.js
@@ -130,7 +130,7 @@
             // the grant itself holds no running total.
             const token = grantToToken(grant);
             token.rawOriginator = args.originator;
-            const spent = await this.querySpentSince(token);
+            const spent = await this.querySpentSince(token, args.excludeActionReference);
             if (spent + args.satoshis <= grant.authorizedAmount)
                 return true;
         }
